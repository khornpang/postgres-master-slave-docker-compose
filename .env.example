# Non-secret configuration. Secrets live in ./secrets/*.txt (gitignored).
# Copy this file to .env. The compose file reads from .env automatically.

POSTGRES_USER=app
# Comma-separated list of databases to create on the primary and expose
# via PgBouncer. The first entry is the bootstrap database that the
# postgres image creates at initdb time; the rest are created by
# init-primary.sh. PgBouncer renders one writes pool + one reads pool
# (<db> and <db>_ro) for each entry.
POSTGRES_DBS=monitor,logger
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

REPLICATION_USER=replicator
READONLY_USER=app_readonly
PGBOUNCER_AUTH_USER=pgbouncer

# Backup
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"
